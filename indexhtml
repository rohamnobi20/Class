async function enableMedia(){if(stream)return true;
 if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){add('','این محیط اجازه‌ی دوربین/میکروفون نمی‌دهد (صفحه باید با HTTPS باز شود).');$('media').style.display='';return false}
 let s=null,err=null;try{s=await navigator.mediaDevices.getUserMedia({video:{width:640,height:480},audio:true})}catch(e){err=e;try{s=await navigator.mediaDevices.getUserMedia({audio:true})}catch(e2){err=e2}}
 if(!s){lastErr=err;add('',errMsg(err));$('media').style.display='';return false}
 stream=s;$('media').style.display='none';const a=s.getAudioTracks()[0];if(a)a.enabled=staff(myRole)||allowed;micState();
 tile('me',name+' (شما)',myRole==='teacher',myAv);setStream('me',s,true);Object.values(pcs).forEach(pc=>attach(pc));add('','دوربین/میکروفون فعال شد ✅');return true}
function sseRoom(){const MEP=Math.random().toString(36).slice(2,10)+Date.now().toString(36).slice(-4);
 return{join:async code=>{const sub={},ph=new Set();let peers=[],prev={};const es=new EventSource('/events?room='+encodeURIComponent(code)+'&peer='+MEP);es.onopen=()=>setNet(true);es.onerror=()=>setNet(false);
  const post=(u,b)=>fetch(u,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.assign({room:code,peer:MEP},b))}).then(()=>{});
  es.addEventListener('peers',e=>{const L=JSON.parse(e.data),old=prev,cur={};
   peers=L.map(p=>{const q={peer:p.peer,isMe:p.peer===MEP,sameTab:p.peer===MEP,kind:'viewer',guest:false,by:null,presence:p.presence||{}};cur[p.peer]=q;return q});
   const joined=peers.filter(p=>!old[p.peer]),left=Object.keys(old).filter(k=>!cur[k]).map(k=>old[k]),updated=peers.filter(p=>old[p.peer]&&JSON.stringify(old[p.peer].presence)!==JSON.stringify(p.presence));
   prev=cur;ph.forEach(h=>h({peers,joined,left,updated}))});
  es.addEventListener('msg',e=>{const m=JSON.parse(e.data);m.isMe=m.peer===MEP;m.sameTab=m.isMe;(sub[m.topic]||[]).forEach(h=>h(m))});
  return{emit:(t,d)=>post('/emit',{topic:t,data:d}),on:(t,h)=>{(sub[t]=sub[t]||[]).push(h);return()=>{}},presence:pa=>post('/presence',{patch:pa}),onPeers:h=>{ph.add(h);return()=>ph.delete(h)},peers:()=>peers,leave:async()=>{es.close();post('/leave',{})}}}}}

// ---- بدون سرور: سیگنال‌دهی از طریق بروکر عمومی MQTT (برای GitHub Pages و هاست‌های ایستا)
const useMqtt=!location.search.includes('sse');
function loadMqtt(){return new Promise((ok,no)=>{if(window.mqtt)return ok();const z=document.createElement('script');z.src='https://cdn.jsdelivr.net/npm/mqtt@5.10.1/dist/mqtt.min.js';z.onload=ok;z.onerror=no;document.head.appendChild(z)})}
function mqttRoom(){const MEP=Math.random().toString(36).slice(2,10)+Date.now().toString(36).slice(-4),BR=['wss://broker.emqx.io:8084/mqtt','wss://broker.hivemq.com:8884/mqtt'];
 return{join:async code=>{await loadMqtt();const base='rohamclass1/'+code,pt=base+'/p/'+MEP;let cl=null;
  for(const u of BR){try{cl=await new Promise((ok,no)=>{const c=mqtt.connect(u,{clientId:'rc'+MEP,clean:true,reconnectPeriod:3000,connectTimeout:6000,will:{topic:pt,payload:'',retain:true,qos:0}});
   const to=setTimeout(()=>{c.end(true);no()},7000);c.once('connect',()=>{clearTimeout(to);ok(c)});c.on('error',()=>{})});break}catch(e){}}
  if(!cl)throw new Error('broker');
  const sub={},ph=new Set(),BADK=['__proto__','constructor','prototype'];let prev={},pm={},mine={},tm=null;
  cl.on('connect',()=>setNet(true));cl.on('close',()=>setNet(false));
  function flushPeers(){const old=prev,cur={};const peers=Object.keys(pm).map(id=>{const q={peer:id,isMe:id===MEP,sameTab:id===MEP,kind:'viewer',guest:false,by:null,presence:pm[id]};cur[id]=q;return q});
   const joined=peers.filter(q=>!old[q.peer]),left=Object.keys(old).filter(k=>!cur[k]).map(k=>old[k]),updated=peers.filter(q=>old[q.peer]&&JSON.stringify(old[q.peer].presence)!==JSON.stringify(q.presence));
   prev=cur;ph.forEach(h=>h({peers,joined,left,updated}))}
  cl.on('message',(tp,pl)=>{const z=pl.toString();
   if(tp===base+'/e'){let m;try{m=JSON.parse(z)}catch(e){return}m.isMe=m.peer===MEP;m.sameTab=m.isMe;(sub[m.topic]||[]).forEach(h=>h(m))}
   else if(tp.startsWith(base+'/p/')){const id=tp.slice(base.length+3);if(!z)delete pm[id];else{try{pm[id]=JSON.parse(z)}catch(e){return}}clearTimeout(tm);tm=setTimeout(flushPeers,60)}});
  cl.subscribe([base+'/e',base+'/p/+']);cl.publish(pt,JSON.stringify(mine),{retain:true});
  return{emit:(t,d)=>new Promise((ok,no)=>cl.publish(base+'/e',JSON.stringify({topic:t,data:d,peer:MEP}),e=>e?no(e):ok())),
   on:(t,h)=>{(sub[t]=sub[t]||[]).push(h);return()=>{}},
   presence:pa=>{for(const k in pa){if(BADK.includes(k))continue;if(pa[k]===null)delete mine[k];else mine[k]=pa[k]}cl.publish(pt,JSON.stringify(mine),{retain:true});return Promise.resolve()},
   onPeers:h=>{ph.add(h);return()=>ph.delete(h)},peers:()=>Object.values(prev),
   leave:async()=>{cl.publish(pt,'',{retain:true},()=>cl.end())}}}}}
const getRoom=async()=>useMqtt?mqttRoom():sseRoom();

